    { "id": "g4m-w23-thu-002", "question": "When adding like fractions, we add the ___ and keep the denominator.", "options": ["Denominators", "Numerators", "Wholes", "Both"], "correctIndex": 1, "explanation": "Add the numerators; the denominator stays the same.", "tags": ["addition", "rule"] },
