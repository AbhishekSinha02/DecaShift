  "questions": [
    { "id": "g5m-w22-tue-001", "question": "What is 10% of 80?", "options": ["6", "7", "8", "9"], "correctIndex": 2, "explanation": "10% of 80 = 80 × 10/100 = 8.", "tags": ["percentage"] },
    { "id": "g5m-w22-tue-002", "question": "A book costs ₹200. It is sold at 15% discount. What is the sale price?", "options": ["₹160", "₹170", "₹175", "₹180"], "correctIndex": 1, "explanation": "Discount = 15% of 200 = 30. Sale price = 200 − 30 = ₹170.", "tags": ["percentage", "discount"] },
    { "id": "g5m-w22-tue-003", "question": "What percent of 50 is 25?", "options": ["25%", "40%", "50%", "75%"], "correctIndex": 2, "explanation": "25/50 × 100 = 50%.", "tags": ["percentage"] },
    { "id": "g5m-w22-tue-004", "question": "Convert 3/4 to a percentage.", "options": ["60%", "70%", "75%", "80%"], "correctIndex": 2, "explanation": "3/4 × 100 = 75%.", "tags": ["percentage", "fractions"] },
    { "id": "g5m-w22-tue-005", "question": "In a class of 40, 60% are girls. How many boys are there?", "options": ["14", "16", "18", "24"], "correctIndex": 1, "explanation": "Girls = 60% of 40 = 24. Boys = 40 − 24 = 16.", "tags": ["percentage", "word-problem"] },
    { "id": "g5m-w22-tue-006", "question": "What is 5% of 1000?", "options": ["5", "50", "500", "100"], "correctIndex": 1, "explanation": "5/100 × 1000 = 50.", "tags": ["percentage"] },
    { "id": "g5m-w22-tue-007", "question": "A shirt's price increases from ₹400 to ₹500. What is the percentage increase?", "options": ["20%", "25%", "30%", "35%"], "correctIndex": 1, "explanation": "Increase = 100. % increase = 100/400 × 100 = 25%.", "tags": ["percentage", "word-problem"] },
    { "id": "g5m-w22-tue-008", "question": "What is 120% of 50?", "options": ["50", "55", "60", "65"], "correctIndex": 2, "explanation": "120/100 × 50 = 1.2 × 50 = 60.", "tags": ["percentage"] },
    { "id": "g5m-w22-tue-009", "question": "What percentage of 200 is 30?", "options": ["10%", "12%", "15%", "20%"], "correctIndex": 2, "explanation": "30/200 × 100 = 15%.", "tags": ["percentage"] },
    { "id": "g5m-w22-tue-010", "question": "If 40% of a number is 80, what is the number?", "options": ["160", "180", "200", "220"], "correctIndex": 2, "explanation": "Let number = x. 40% of x = 80 → x = 80 × 100/40 = 200.", "tags": ["percentage", "algebra"] },
    { "id": "g5m-w22-tue-011", "question": "A shopkeeper bought an item for ₹300 and sold it for ₹360. What is the profit percentage?", "options": ["15%", "18%", "20%", "25%"], "correctIndex": 2, "explanation": "Profit = 60. Profit% = 60/300 × 100 = 20%.", "tags": ["percentage", "profit-loss"] },
    { "id": "g5m-w22-tue-012", "question": "Convert 0.35 to a percentage.", "options": ["3.5%", "35%", "350%", "0.35%"], "correctIndex": 1, "explanation": "0.35 × 100 = 35%.", "tags": ["percentage", "decimals"] },
    { "id": "g5m-w22-tue-013", "question": "What is 25% of 120?", "options": ["25", "28", "30", "35"], "correctIndex": 2, "explanation": "25/100 × 120 = 30.", "tags": ["percentage"] },
    { "id": "g5m-w22-tue-014", "question": "Riya scored 45 out of 60. What is her percentage?", "options": ["65%", "70%", "75%", "80%"], "correctIndex": 2, "explanation": "45/60 × 100 = 75%.", "tags": ["percentage", "word-problem"] },
    { "id": "g5m-w22-tue-015", "question": "Which is greater: 35% of 80 or 40% of 70?", "options": ["35% of 80", "40% of 70", "Both are equal", "Cannot be compared"], "correctIndex": 2, "explanation": "35% of 80 = 28. 40% of 70 = 28. Both are equal.", "tags": ["percentage", "comparison"] }
  ]
