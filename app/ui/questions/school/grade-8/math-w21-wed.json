    { "id": "g8m-w21-wed-001", "question": "Rule for multiplying two rational numbers:", "options": ["Add numerators and denominators", "(p/q) × (r/s) = (p×r)/(q×s)", "Find LCM first, then multiply", "Multiply numerator by denominator"], "correctIndex": 1, "explanation": "Multiply numerators together, denominators together: (p/q) × (r/s) = pr/qs. Then simplify.", "tags": ["multiply-rule"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-002", "question": "3/4 × 8/9 = ?", "options": ["24/36 = 2/3", "11/13", "8/12", "3/8"], "correctIndex": 0, "explanation": "(3×8)/(4×9) = 24/36. Simplify: GCD(24,36)=12. 24/36 = 2/3.", "tags": ["multiply-fractions"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-003", "question": "(−5/7) × (−3/10) = ?", "options": ["−15/70", "15/70 = 3/14", "−3/14", "8/70"], "correctIndex": 1, "explanation": "Negative × negative = positive. (5×3)/(7×10) = 15/70 = 3/14.", "tags": ["negative-multiply"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-004", "question": "Rule for dividing rational numbers:", "options": ["Divide numerator by numerator, denominator by denominator", "Multiply by the reciprocal of the divisor", "Subtract denominators", "Find LCM of numerators"], "correctIndex": 1, "explanation": "p/q ÷ r/s = p/q × s/r (multiply by the reciprocal). Flip the second fraction then multiply.", "tags": ["divide-rule"], "correctIndex": 1, "conceptLevel": 2 },
    { "id": "g8m-w21-wed-005", "question": "3/5 ÷ 9/10 = ?", "options": ["27/50", "2/3", "3/10", "10/3"], "correctIndex": 1, "explanation": "3/5 × 10/9 = 30/45 = 2/3.", "tags": ["divide-fractions"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-006", "question": "(−2/3) ÷ (4/9) = ?", "options": ["−3/2", "−8/27", "3/2", "−1/6"], "correctIndex": 0, "explanation": "(−2/3) × (9/4) = −18/12 = −3/2.", "tags": ["divide-negative"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-007", "question": "7/8 × 0 = ?", "options": ["7/8", "0", "Undefined", "8/7"], "correctIndex": 1, "explanation": "Any rational number multiplied by 0 = 0. Multiplication by 0 property.", "tags": ["multiply-by-zero"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-008", "question": "Distributive law: 2/3 × (3/4 + 1/2) = ?", "options": ["2/3 × 3/4 + 2/3 × 1/2", "2/3 × 3/4 × 1/2", "2/3 + 3/4 + 1/2", "Cannot apply distributive law to rationals"], "correctIndex": 0, "explanation": "Distributive law: a(b+c) = ab + ac. Apply: 2/3×3/4 + 2/3×1/2 = 1/2 + 1/3 = 5/6.", "tags": ["distributive-law"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-009", "question": "Verify: 2/3 × (3/4 + 1/2) using both methods", "options": ["5/6 (both methods agree)", "7/6 (method 1) vs 5/6 (method 2)", "1 (both methods)", "2/3 (bracket first)"], "correctIndex": 0, "explanation": "Bracket first: 3/4 + 1/2 = 5/4. Then 2/3 × 5/4 = 10/12 = 5/6. Distributive: 1/2+1/3 = 5/6. ✓", "tags": ["distributive-verify"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-010", "question": "A rectangle has sides 5/6 m and 8/15 m. Find its area.", "options": ["13/21 m²", "4/9 m²", "1/3 m²", "40/90 m²"], "correctIndex": 1, "explanation": "Area = l×w = 5/6 × 8/15 = 40/90 = 4/9 m².", "tags": ["area-rational-sides"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-011", "question": "A pipe fills 3/8 of a tank per hour. How many hours to fill the tank?", "options": ["3/8 hours", "8/3 hours", "3 hours", "24 hours"], "correctIndex": 1, "explanation": "Time = 1 ÷ (3/8) = 8/3 hours = 2⅔ hours.", "tags": ["pipe-rate-rational"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-012", "question": "Simplify: (−4/5) × (25/16)", "options": ["−100/80 = −5/4", "5/4", "−4/5", "−5/4"], "correctIndex": 3, "explanation": "(−4×25)/(5×16) = −100/80 = −5/4.", "tags": ["simplify-multiply"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-013", "question": "Which property: (2/3 × 4/5) × 3/7 = 2/3 × (4/5 × 3/7)?", "options": ["Commutative", "Associative", "Distributive", "Identity"], "correctIndex": 1, "explanation": "Associative property of multiplication: (a×b)×c = a×(b×c). Grouping doesn't change the product.", "tags": ["associative-multiplication"], "conceptLevel": 2 },
    { "id": "g8m-w21-wed-014", "question": "Sign rule for rational multiplication:", "options": ["+×+ = −, −×− = +", "+×+ = +, −×− = +, +×− = −", "+×+ = +, −×− = −, +×− = +", "Signs are ignored"], "correctIndex": 1, "explanation": "Same signs → positive. Different signs → negative. (+)(+)=+, (−)(−)=+, (+)(−)=−, (−)(+)=−.", "tags": ["sign-rules-multiply"], "conceptLevel": 2 },
