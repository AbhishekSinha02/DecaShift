    { "id": "g5m-w23-tue-003", "question": "0.75 as a percent is ___.", "options": ["7.5%", "75%", "750%", "0.75%"], "correctIndex": 1, "explanation": "0.75 × 100 = 75%.", "tags": ["conversion", "decimal"] },
    { "id": "g5m-w23-tue-004", "question": "25% written as a decimal is ___.", "options": ["2.5", "0.25", "0.025", "25.0"], "correctIndex": 1, "explanation": "25 ÷ 100 = 0.25.", "tags": ["conversion", "decimal"] },
