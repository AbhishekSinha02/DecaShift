  "tags": ["math", "grade-7", "weekly", "algebra", "word-problems", "synthesis"],
  "questions": [
    { "id": "g7m-w22-fri-001", "question": "The sum of three consecutive integers is 54. Find the smallest.", "options": ["16", "17", "18", "19"], "correctIndex": 1, "explanation": "Let integers be n, n+1, n+2. Then 3n+3 = 54 → 3n = 51 → n = 17.", "tags": ["linear-equations", "consecutive", "word-problem"], "conceptLevel": 4 },
    { "id": "g7m-w22-fri-002", "question": "A number doubled and added to 15 gives 37. Find the number.", "options": ["8", "10", "11", "14"], "correctIndex": 2, "explanation": "Let number = x. 2x + 15 = 37 → 2x = 22 → x = 11.", "tags": ["linear-equations", "word-problem"], "conceptLevel": 3 },
    { "id": "g7m-w22-fri-003", "question": "Ravi is 6 years older than his brother. Sum of their ages is 32. Find Ravi's age.", "options": ["13", "17", "19", "25"], "correctIndex": 2, "explanation": "Let brother = x. Then x + (x+6) = 32 → 2x = 26 → x = 13. Ravi = 13+6 = 19.", "tags": ["linear-equations", "age-problem"], "conceptLevel": 3 },
    { "id": "g7m-w22-fri-004", "question": "A class has boys = girls + 8 and total = 50. How many girls?", "options": ["17", "21", "25", "29"], "correctIndex": 1, "explanation": "Let girls = g. g + (g+8) = 50 → 2g = 42 → g = 21.", "tags": ["linear-equations", "word-problem"], "conceptLevel": 3 },
    { "id": "g7m-w22-fri-005", "question": "A number divided by 5 and 3 added gives 11. Find the number.", "options": ["35", "40", "45", "50"], "correctIndex": 1, "explanation": "x/5 + 3 = 11 → x/5 = 8 → x = 40.", "tags": ["linear-equations", "word-problem"], "conceptLevel": 3 },
    { "id": "g7m-w22-fri-006", "question": "Priya thinks of a number, multiplies by 4, subtracts 9. Result is 23. What's the number?", "options": ["6", "7", "8", "9"], "correctIndex": 2, "explanation": "4x − 9 = 23 → 4x = 32 → x = 8.", "tags": ["linear-equations", "think-of-number"], "conceptLevel": 3 },
    { "id": "g7m-w22-fri-007", "question": "Two friends have ₹(3x+10) and ₹(5x−14). They have equal money. Find x.", "options": ["8", "10", "12", "14"], "correctIndex": 2, "explanation": "3x+10 = 5x−14 → 24 = 2x → x = 12.", "tags": ["linear-equations", "equal-expressions"], "conceptLevel": 4 },
    { "id": "g7m-w22-fri-008", "question": "Perimeter of rectangle is 56 cm. Length = 3 × breadth. Find the breadth.", "options": ["5", "7", "9", "14"], "correctIndex": 1, "explanation": "2(l+b) = 56 → l+b = 28. 3b+b = 28 → 4b = 28 → b = 7.", "tags": ["linear-equations", "geometry", "word-problem"], "conceptLevel": 4 },
    { "id": "g7m-w22-fri-009", "question": "3 items sold at same price, ₹15 discount given, final amount ₹75. Price per item?", "options": ["20", "25", "30", "35"], "correctIndex": 2, "explanation": "3x − 15 = 75 → 3x = 90 → x = 30.", "tags": ["linear-equations", "discount", "word-problem"], "conceptLevel": 3 },
    { "id": "g7m-w22-fri-010", "question": "Difference between two numbers is 18. Larger is twice the smaller. Find the larger.", "options": ["18", "27", "36", "54"], "correctIndex": 2, "explanation": "Let smaller = x. 2x − x = 18 → x = 18. Larger = 2 × 18 = 36.", "tags": ["linear-equations", "ratio-type", "word-problem"], "conceptLevel": 4 },
    { "id": "g7m-w22-fri-011", "question": "In 8 years, Arun will be 3 times as old as he was 4 years ago. How old is he now?", "options": ["8", "10", "12", "14"], "correctIndex": 1, "explanation": "x + 8 = 3(x − 4) → x + 8 = 3x − 12 → 20 = 2x → x = 10.", "tags": ["linear-equations", "age-problem"], "conceptLevel": 4 },
    { "id": "g7m-w22-fri-012", "question": "A bag has ₹1 and ₹2 coins. Total 30 coins worth ₹46. How many ₹2 coins?", "options": ["12", "14", "16", "18"], "correctIndex": 2, "explanation": "Let ₹2 coins = x. ₹1 coins = 30−x. 2x + (30−x) = 46 → x = 16.", "tags": ["linear-equations", "coins", "word-problem"], "conceptLevel": 4 },
    { "id": "g7m-w22-fri-013", "question": "Angles of a triangle are in ratio 2:3:4. Find the largest angle.", "options": ["40°", "60°", "80°", "100°"], "correctIndex": 2, "explanation": "2x+3x+4x = 180 → 9x = 180 → x = 20. Largest = 4×20 = 80°.", "tags": ["linear-equations", "angles", "geometry"], "conceptLevel": 4 },
    { "id": "g7m-w22-fri-014", "question": "A farmer has chickens and cows. Total 20 animals, total legs 56. How many cows?", "options": ["6", "7", "8", "9"], "correctIndex": 2, "explanation": "Let cows = c. Chickens = 20−c. 4c + 2(20−c) = 56 → 2c + 40 = 56 → c = 8.", "tags": ["linear-equations", "simultaneous-logic", "word-problem"], "conceptLevel": 4 },
    { "id": "g7m-w22-fri-015", "question": "Three times a number minus 7 equals twice the number plus 5. Find the number.", "options": ["7", "12", "16", "3"], "correctIndex": 1, "explanation": "3x − 7 = 2x + 5 → x = 12.", "tags": ["linear-equations", "word-problem"], "conceptLevel": 3 }
  ]
}
