  "questions": [
    { "id": "g2m-w21-tue-001", "question": "What is 21 + 13?", "options": ["32", "33", "34", "35"], "correctIndex": 2, "explanation": "21 + 13 = 34. Add tens: 20 + 10 = 30. Add ones: 1 + 3 = 4. Together: 34.", "tags": ["2-digit-no-carry"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-002", "question": "What is 32 + 25?", "options": ["55", "56", "57", "58"], "correctIndex": 2, "explanation": "32 + 25 = 57. Tens: 30 + 20 = 50. Ones: 2 + 5 = 7. Total: 57.", "tags": ["2-digit-no-carry"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-003", "question": "40 + 30 = ?", "options": ["60", "70", "80", "75"], "correctIndex": 1, "explanation": "40 + 30 = 70. Count by tens: 40, 50, 60, 70 — that's 3 jumps of 10.", "tags": ["tens-addition"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-004", "question": "There are 24 boys and 13 girls in a class. How many children in all?", "options": ["35", "36", "37", "38"], "correctIndex": 2, "explanation": "24 + 13 = 37. Tens: 20 + 10 = 30. Ones: 4 + 3 = 7. Total: 37.", "tags": ["word-problem"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-005", "question": "What is 50 + 26?", "options": ["74", "75", "76", "77"], "correctIndex": 2, "explanation": "50 + 26 = 76. 50 + 20 = 70, then + 6 = 76.", "tags": ["2-digit-no-carry"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-006", "question": "What is 11 + 11?", "options": ["20", "21", "22", "23"], "correctIndex": 2, "explanation": "11 + 11 = 22. Double 11. Tens: 10 + 10 = 20. Ones: 1 + 1 = 2. Total: 22.", "tags": ["doubles"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-007", "question": "45 + ___ = 55. What is the missing number?", "options": ["8", "9", "10", "11"], "correctIndex": 2, "explanation": "45 + 10 = 55. The tens digit goes up by 1 when you add 10.", "tags": ["missing-addend"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-008", "question": "What is 33 + 44?", "options": ["75", "76", "77", "78"], "correctIndex": 2, "explanation": "33 + 44 = 77. Tens: 30 + 40 = 70. Ones: 3 + 4 = 7. Total: 77.", "tags": ["2-digit-no-carry"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-009", "question": "A shop has 62 red pens and 16 blue pens. How many pens in all?", "options": ["76", "77", "78", "79"], "correctIndex": 2, "explanation": "62 + 16 = 78. Tens: 60 + 10 = 70. Ones: 2 + 6 = 8. Total: 78.", "tags": ["word-problem"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-010", "question": "What is 10 + 10 + 10?", "options": ["20", "30", "40", "50"], "correctIndex": 1, "explanation": "10 + 10 + 10 = 30. Three tens make thirty.", "tags": ["counting-tens"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-011", "question": "What is 14 + 23?", "options": ["35", "36", "37", "38"], "correctIndex": 2, "explanation": "14 + 23 = 37. Tens: 10 + 20 = 30. Ones: 4 + 3 = 7. Total: 37.", "tags": ["2-digit-no-carry"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-012", "question": "Which is the biggest sum?", "options": ["20 + 10", "15 + 14", "11 + 22", "30 + 5"], "correctIndex": 3, "explanation": "30 + 5 = 35. Others: 30, 29, 33. So 35 is the biggest.", "tags": ["compare-sums"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-013", "question": "What is 70 + 20?", "options": ["80", "85", "90", "92"], "correctIndex": 2, "explanation": "70 + 20 = 90. Seven tens + two tens = nine tens = 90.", "tags": ["tens-addition"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-014", "question": "Arjun has 31 marbles and gets 47 more. How many does he have?", "options": ["76", "77", "78", "79"], "correctIndex": 2, "explanation": "31 + 47 = 78. Tens: 30 + 40 = 70. Ones: 1 + 7 = 8. Total: 78.", "tags": ["word-problem"], "conceptLevel": 1 },
    { "id": "g2m-w21-tue-015", "question": "What is 25 + 25?", "options": ["48", "49", "50", "51"], "correctIndex": 2, "explanation": "25 + 25 = 50. Double 25 = 50. Tens: 20 + 20 = 40. Ones: 5 + 5 = 10. 40 + 10 = 50.", "tags": ["doubles"], "conceptLevel": 1 }
