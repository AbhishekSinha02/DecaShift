  "questions": [
    { "id": "g7m-w22-mon-001", "question": "Which of these is a linear equation in one variable?", "options": ["x² + 3 = 7", "2x + y = 5", "3x + 4 = 10", "xy = 12"], "correctIndex": 2, "explanation": "3x + 4 = 10 has exactly one variable (x) with power 1. x² has power 2; 2x + y and xy have two variables.", "tags": ["linear-equations", "concept"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-002", "question": "Solve: x + 6 = 10", "options": ["2", "4", "6", "16"], "correctIndex": 1, "explanation": "Subtract 6 from both sides: x = 10 − 6 = 4.", "tags": ["linear-equations", "one-step"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-003", "question": "Solve: x − 3 = 9", "options": ["3", "6", "12", "27"], "correctIndex": 2, "explanation": "Add 3 to both sides: x = 9 + 3 = 12.", "tags": ["linear-equations", "one-step"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-004", "question": "What is the LHS of the equation x + 5 = 14?", "options": ["14", "x + 5", "5", "x − 5"], "correctIndex": 1, "explanation": "LHS (Left Hand Side) is everything to the left of the equal sign: x + 5.", "tags": ["linear-equations", "concept"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-005", "question": "Solve: y + 15 = 23", "options": ["7", "8", "9", "38"], "correctIndex": 1, "explanation": "y = 23 − 15 = 8.", "tags": ["linear-equations", "one-step"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-006", "question": "Which value of a satisfies a − 2 = 3?", "options": ["1", "5", "6", "23"], "correctIndex": 1, "explanation": "a = 3 + 2 = 5. Check: 5 − 2 = 3 ✓", "tags": ["linear-equations", "verification"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-007", "question": "Solve: n − 8 = 17", "options": ["9", "25", "126", "8"], "correctIndex": 1, "explanation": "n = 17 + 8 = 25.", "tags": ["linear-equations", "one-step"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-008", "question": "What is the value we find that makes an equation true called?", "options": ["Coefficient", "Solution", "Variable", "Constant"], "correctIndex": 1, "explanation": "The value that satisfies an equation is called its solution or root.", "tags": ["linear-equations", "concept"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-009", "question": "Solve: p + 27 = 41", "options": ["14", "16", "68", "1107"], "correctIndex": 0, "explanation": "p = 41 − 27 = 14.", "tags": ["linear-equations", "one-step"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-010", "question": "Which value satisfies 7 + m = 20?", "options": ["11", "12", "13", "27"], "correctIndex": 2, "explanation": "m = 20 − 7 = 13. Check: 7 + 13 = 20 ✓", "tags": ["linear-equations", "one-step"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-011", "question": "In equation 3x = 15, what does 3 represent?", "options": ["Variable", "Solution", "Coefficient of x", "Constant"], "correctIndex": 2, "explanation": "The number multiplied by the variable is called its coefficient. Here 3 is the coefficient of x.", "tags": ["linear-equations", "concept"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-012", "question": "Solve: z − 14 = 22", "options": ["8", "26", "36", "308"], "correctIndex": 2, "explanation": "z = 22 + 14 = 36.", "tags": ["linear-equations", "one-step"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-013", "question": "Which equation has solution x = 10?", "options": ["x + 4 = 15", "x − 3 = 7", "x + 2 = 8", "x − 5 = 15"], "correctIndex": 1, "explanation": "x − 3 = 7 → 10 − 3 = 7 ✓. Others: 10+4=14≠15; 10+2=12≠8; 10−5=5≠15.", "tags": ["linear-equations", "verification"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-014", "question": "Solve: k + 45 = 100", "options": ["55", "45", "65", "145"], "correctIndex": 0, "explanation": "k = 100 − 45 = 55.", "tags": ["linear-equations", "one-step"], "conceptLevel": 0 },
    { "id": "g7m-w22-mon-015", "question": "If the equation is a + b = c, which is the unknown we need to find?", "options": ["a only", "b only", "c only", "It depends which is not given"], "correctIndex": 3, "explanation": "In an equation, the variable (unknown) is whichever letter's value we don't know. It depends on what information is given.", "tags": ["linear-equations", "concept"], "conceptLevel": 0 }
