  "questions": [
    { "id": "g2m-w21-thu-001", "question": "What is 10 − 4?", "options": ["5", "6", "7", "8"], "correctIndex": 1, "explanation": "10 − 4 = 6. Count back 4 from 10: 9, 8, 7, 6.", "tags": ["subtraction-basic"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-002", "question": "What is 15 − 8?", "options": ["5", "6", "7", "8"], "correctIndex": 2, "explanation": "15 − 8 = 7. Count back: 14, 13, 12, 11, 10, 9, 8, 7 — that's 8 steps back.", "tags": ["subtraction"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-003", "question": "Meena has 20 sweets and gives 7 to her friend. How many left?", "options": ["11", "12", "13", "14"], "correctIndex": 2, "explanation": "20 − 7 = 13. 20 take away 7 leaves 13.", "tags": ["word-problem"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-004", "question": "What is 50 − 20?", "options": ["20", "25", "30", "35"], "correctIndex": 2, "explanation": "50 − 20 = 30. Five tens minus two tens = three tens = 30.", "tags": ["tens-subtraction"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-005", "question": "What is 38 − 15?", "options": ["21", "22", "23", "24"], "correctIndex": 2, "explanation": "38 − 15 = 23. Ones: 8 − 5 = 3. Tens: 3 − 1 = 2. Answer: 23.", "tags": ["2-digit-no-borrow"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-006", "question": "47 − ___ = 40. What is missing?", "options": ["5", "6", "7", "8"], "correctIndex": 2, "explanation": "47 − 7 = 40. We subtract the ones digit to get to the nearest ten.", "tags": ["missing-subtrahend"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-007", "question": "A bag had 65 biscuits. 33 were eaten. How many are left?", "options": ["30", "31", "32", "33"], "correctIndex": 2, "explanation": "65 − 33 = 32. Ones: 5 − 3 = 2. Tens: 6 − 3 = 3. Answer: 32.", "tags": ["word-problem"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-008", "question": "What is 100 − 50?", "options": ["40", "50", "60", "70"], "correctIndex": 1, "explanation": "100 − 50 = 50. Half of 100 is 50.", "tags": ["100-minus"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-009", "question": "What is 29 − 14?", "options": ["13", "14", "15", "16"], "correctIndex": 2, "explanation": "29 − 14 = 15. Ones: 9 − 4 = 5. Tens: 2 − 1 = 1. Answer: 15.", "tags": ["2-digit"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-010", "question": "Addition and subtraction are opposites. If 4 + 5 = 9, then 9 − 5 = ?", "options": ["3", "4", "5", "6"], "correctIndex": 1, "explanation": "9 − 5 = 4. Addition and subtraction are inverse operations. Knowing 4 + 5 = 9 helps us find 9 − 5 = 4.", "tags": ["inverse-operations"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-011", "question": "What is 76 − 34?", "options": ["40", "41", "42", "43"], "correctIndex": 2, "explanation": "76 − 34 = 42. Ones: 6 − 4 = 2. Tens: 7 − 3 = 4. Answer: 42.", "tags": ["2-digit"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-012", "question": "There are 80 children at school. 25 go home early. How many remain?", "options": ["53", "54", "55", "56"], "correctIndex": 2, "explanation": "80 − 25 = 55. Ones: 0 − 5 (need to borrow) → 10 − 5 = 5. Tens: 7 − 2 = 5. Answer: 55.", "tags": ["word-problem"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-013", "question": "Which fact helps you solve 13 − 6?", "options": ["6 + 7 = 13", "6 + 8 = 14", "5 + 8 = 13", "7 + 7 = 14"], "correctIndex": 0, "explanation": "6 + 7 = 13 helps us know 13 − 6 = 7. Addition facts help us solve subtraction.", "tags": ["fact-families"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-014", "question": "What is 55 − 55?", "options": ["0", "1", "10", "55"], "correctIndex": 0, "explanation": "55 − 55 = 0. Any number minus itself equals 0.", "tags": ["same-number"], "conceptLevel": 2 },
    { "id": "g2m-w21-thu-015", "question": "What is 99 − 9?", "options": ["88", "89", "90", "91"], "correctIndex": 2, "explanation": "99 − 9 = 90. Ones: 9 − 9 = 0. Tens: 9 − 0 = 9. Answer: 90.", "tags": ["subtraction"], "conceptLevel": 2 }
  ]
}
