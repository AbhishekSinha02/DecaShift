    { "id": "g3h-w21-fri-003", "question": "पर्यावरण को बचाने के लिए हमें क्या करना चाहिए?", "options": ["अधिक कूड़ा फेंकना", "पेड़ काटना", "पेड़ लगाना और पानी बचाना", "बिजली बर्बाद करना"], "correctIndex": 2, "explanation": "पर्यावरण बचाने के लिए पेड़ लगाएँ, पानी बचाएँ, और कूड़ा सही जगह डालें।", "tags": ["environment"] },
    { "id": "g3h-w21-fri-004", "question": "'पहाड़' को अंग्रेज़ी में कहते हैं:", "options": ["Valley", "Mountain", "Desert", "Forest"], "correctIndex": 1, "explanation": "'पहाड़' = Mountain।", "tags": ["nature", "vocabulary"] },
    { "id": "g3h-w21-fri-005", "question": "वर्षा ऋतु में क्या होता है?", "options": ["बर्फ पड़ती है", "गर्मी बढ़ती है", "बारिश होती है", "पत्ते झड़ते हैं"], "correctIndex": 2, "explanation": "वर्षा ऋतु (monsoon season) में बारिश होती है। भारत में यह जून–सितंबर तक होती है।", "tags": ["nature", "seasons"] },
    { "id": "g3h-w21-fri-006", "question": "'समुद्र' का अंग्रेज़ी नाम है:", "options": ["River", "Lake", "Ocean/Sea", "Pond"], "correctIndex": 2, "explanation": "'समुद्र' = Ocean / Sea।", "tags": ["nature", "vocabulary"] },
    { "id": "g3h-w21-fri-007", "question": "कौन सी ऋतु (season) में ठंड होती है?", "options": ["ग्रीष्म ऋतु", "वर्षा ऋतु", "शीत ऋतु", "बसंत ऋतु"], "correctIndex": 2, "explanation": "'शीत ऋतु' (winter season) में ठंड होती है।", "tags": ["nature", "seasons"] },
    { "id": "g3h-w21-fri-008", "question": "'जंगल' को अंग्रेज़ी में कहते हैं:", "options": ["Garden", "Park", "Forest", "Farm"], "correctIndex": 2, "explanation": "'जंगल' = Forest।", "tags": ["nature", "vocabulary"] },
