    { "id": "g3h-w21-fri-014", "question": "'बादल' को अंग्रेज़ी में कहते हैं:", "options": ["Rain", "Wind", "Cloud", "Sky"], "correctIndex": 2, "explanation": "'बादल' = Cloud।", "tags": ["nature", "vocabulary"] },
    { "id": "g3h-w21-fri-015", "question": "हमें पेड़ क्यों लगाने चाहिए?", "options": ["सिर्फ सुंदरता के लिए", "ऑक्सीजन देते हैं, प्रदूषण कम करते हैं, और जीवों को घर देते हैं", "केवल फल के लिए", "केवल छाया के लिए"], "correctIndex": 1, "explanation": "पेड़ ऑक्सीजन देते हैं, कार्बन डाइऑक्साइड सोखते हैं, प्रदूषण कम करते हैं, और पक्षियों को घर देते हैं।", "tags": ["environment"] }
