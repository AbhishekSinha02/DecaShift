    { "id": "g2m-w21-wed-014", "question": "When we carry in addition, what do we always carry?", "options": ["The ones digit only", "A 1 to the next column (tens)", "The full number", "Nothing"], "correctIndex": 1, "explanation": "When ones add up to 10 or more, we carry 1 to the tens column. We keep the ones digit and carry 1.", "tags": ["carrying-concept"], "conceptLevel": 2 },
