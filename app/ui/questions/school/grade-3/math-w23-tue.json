    { "id": "g3m-w23-tue-009", "question": "From the fact 2 × 9 = 18, find 18 ÷ 2.", "options": ["7", "8", "9", "11"], "correctIndex": 2, "explanation": "18 ÷ 2 = 9, the inverse of 2 × 9.", "tags": ["inverse"] },
    { "id": "g3m-w23-tue-010", "question": "How many groups of 5 are in 20?", "options": ["3", "4", "5", "6"], "correctIndex": 1, "explanation": "20 ÷ 5 = 4 groups of 5.", "tags": ["grouping"] },
    { "id": "g3m-w23-tue-011", "question": "If 3 × 7 = 21, then 21 ÷ 7 = ?", "options": ["2", "3", "4", "7"], "correctIndex": 1, "explanation": "21 ÷ 7 = 3, the inverse of 3 × 7.", "tags": ["inverse"] },
    { "id": "g3m-w23-tue-012", "question": "How many times can you subtract 6 from 18?", "options": ["2", "3", "4", "6"], "correctIndex": 1, "explanation": "18 ÷ 6 = 3, so 6 fits 3 times.", "tags": ["repeated-subtraction"] },
