  "questions": [
    { "id": "g6m-w21-thu-001", "question": "Calculate: (−4) × 3", "options": ["12", "−12", "7", "−7"], "correctIndex": 1, "explanation": "Positive × Negative = Negative. 4 × 3 = 12, so (−4) × 3 = −12.", "tags": ["integers", "multiplication", "sign-rule"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-002", "question": "Calculate: (−5) × (−3)", "options": ["−15", "15", "−8", "8"], "correctIndex": 1, "explanation": "Negative × Negative = Positive. 5 × 3 = 15, so (−5) × (−3) = +15.", "tags": ["integers", "multiplication", "sign-rule"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-003", "question": "What is the sign rule: Negative × Positive = ?", "options": ["Positive", "Negative", "Zero", "Depends"], "correctIndex": 1, "explanation": "When signs are different (one positive, one negative), the product is always Negative.", "tags": ["integers", "sign-rule"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-004", "question": "Calculate: (−6) ÷ 2", "options": ["−3", "3", "12", "−12"], "correctIndex": 0, "explanation": "Negative ÷ Positive = Negative. 6 ÷ 2 = 3, so (−6) ÷ 2 = −3.", "tags": ["integers", "division", "sign-rule"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-005", "question": "Calculate: (−24) ÷ (−4)", "options": ["−6", "6", "−28", "28"], "correctIndex": 1, "explanation": "Negative ÷ Negative = Positive. 24 ÷ 4 = 6, so (−24) ÷ (−4) = +6.", "tags": ["integers", "division", "sign-rule"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-006", "question": "Calculate: (−3) × (−2) × (−1)", "options": ["6", "−6", "5", "−5"], "correctIndex": 1, "explanation": "(−3) × (−2) = 6 (two negatives = positive). 6 × (−1) = −6 (positive × negative = negative).", "tags": ["integers", "three-factors", "sign-rule"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-007", "question": "Riya scored −5 points in each of 4 rounds. Total score?", "options": ["20", "−20", "9", "−9"], "correctIndex": 1, "explanation": "4 × (−5) = −20.", "tags": ["integers", "word-problem", "multiplication"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-008", "question": "Calculate: 36 ÷ (−9)", "options": ["4", "−4", "27", "−45"], "correctIndex": 1, "explanation": "Positive ÷ Negative = Negative. 36 ÷ 9 = 4, so 36 ÷ (−9) = −4.", "tags": ["integers", "division", "sign-rule"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-009", "question": "What is (−7) × 0?", "options": ["−7", "7", "0", "Undefined"], "correctIndex": 2, "explanation": "Any number multiplied by 0 is 0. (−7) × 0 = 0.", "tags": ["integers", "multiplication-zero"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-010", "question": "A submarine descends 8 m per minute. After 5 minutes, change in depth?", "options": ["40 m below", "−40 m", "Both are the same answer", "−3 m"], "correctIndex": 2, "explanation": "5 × (−8) = −40 m. Both options A and B say the same thing. Numerically: −40 m.", "tags": ["integers", "word-problem", "multiplication"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-011", "question": "Calculate: (−2) × (−2) × (−2) × (−2)", "options": ["−16", "16", "8", "−8"], "correctIndex": 1, "explanation": "Four negative factors. Even number of negatives → positive. 2⁴ = 16. Answer: +16.", "tags": ["integers", "even-negative-factors"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-012", "question": "If −56 ÷ x = −8, what is x?", "options": ["−7", "7", "−48", "48"], "correctIndex": 1, "explanation": "(−56) ÷ x = −8. x = (−56) ÷ (−8) = 7. Negative ÷ Negative = Positive.", "tags": ["integers", "missing-number", "division"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-013", "question": "Which of these is a true statement?", "options": ["(−3) × (−4) = −12", "(−3) × 4 = 12", "(−3) × (−4) = 12", "3 × (−4) = 12"], "correctIndex": 2, "explanation": "(−3) × (−4) = +12. Two negatives multiply to give positive.", "tags": ["integers", "sign-rule", "true-false"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-014", "question": "The product of an odd number of negative integers is:", "options": ["Always positive", "Always negative", "Always zero", "Could be either"], "correctIndex": 1, "explanation": "Odd count of negative factors → result is negative. Even count → positive.", "tags": ["integers", "sign-rule", "odd-even"], "conceptLevel": 2 },
    { "id": "g6m-w21-thu-015", "question": "Calculate: (−100) ÷ (−25) × (−2)", "options": ["8", "−8", "50", "−50"], "correctIndex": 1, "explanation": "Work left to right: (−100) ÷ (−25) = 4 (neg÷neg = pos). Then 4 × (−2) = −8.", "tags": ["integers", "mixed-operations", "order"], "conceptLevel": 2 }
