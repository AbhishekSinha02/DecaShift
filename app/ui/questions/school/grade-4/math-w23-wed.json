    { "id": "g4m-w23-wed-010", "question": "Arrange smallest to largest: 1/2, 1/4, 1/8", "options": ["1/2, 1/4, 1/8", "1/8, 1/4, 1/2", "1/4, 1/8, 1/2", "1/8, 1/2, 1/4"], "correctIndex": 1, "explanation": "More parts = smaller: 1/8 < 1/4 < 1/2.", "tags": ["comparison", "ordering"] },
    { "id": "g4m-w23-wed-011", "question": "Which is greater: 3/4 or 1/4?", "options": ["1/4", "3/4", "Equal", "Cannot tell"], "correctIndex": 1, "explanation": "Same denominator — 3 > 1, so 3/4 is greater.", "tags": ["comparison"] },
    { "id": "g4m-w23-wed-012", "question": "Which fraction is closest to a whole?", "options": ["1/2", "3/4", "7/8", "1/4"], "correctIndex": 2, "explanation": "7/8 is just 1/8 short of a whole — the closest.", "tags": ["comparison"] },
