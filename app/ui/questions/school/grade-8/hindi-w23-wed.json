    { "id": "g8h-w23-wed-002", "question": "'सत् + जन' की व्यंजन संधि क्या है?", "options": ["सज्जन", "सतजन", "सद्जन", "सच्जन"], "correctIndex": 0, "explanation": "'सत् + जन = सज्जन' (त् + ज = ज्ज)।", "tags": ["join"], "conceptLevel": 0 },
