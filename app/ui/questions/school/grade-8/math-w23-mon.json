    { "id": "g8m-w23-mon-011", "question": "20² = ?", "options": ["200", "400", "420", "40"], "correctIndex": 1, "explanation": "20 × 20 = 400.", "tags": ["squares"] },
    { "id": "g8m-w23-mon-012", "question": "Which number is a perfect square?", "options": ["50", "121", "125", "150"], "correctIndex": 1, "explanation": "121 = 11².", "tags": ["squares"] },
