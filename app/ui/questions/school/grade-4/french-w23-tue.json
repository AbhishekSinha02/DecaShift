  "questions": [
    { "id": "g4f-w23-tue-001", "question": "The special feature of 2nd-group -IR verbs in the plural is the addition of:", "options": ["-iss-", "-er-", "-ant-", "-ez-"], "correctIndex": 0, "explanation": "Plural forms add -iss-: nous finissons, vous finissez, ils finissent. This 'iss' marks the 2nd group.", "tags": ["iss-feature"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-002", "question": "Conjugate 'finir' for 'nous':", "options": ["nous finons", "nous finissons", "nous finissez", "nous finons"], "correctIndex": 1, "explanation": "'Nous finissons' = we finish. Nous → -issons.", "tags": ["finir-nous"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-003", "question": "Conjugate 'finir' for 'vous':", "options": ["vous finissez", "vous finissons", "vous finez", "vous finissent"], "correctIndex": 0, "explanation": "'Vous finissez' = you (plural/formal) finish. Vous → -issez.", "tags": ["finir-vous"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-004", "question": "Conjugate 'finir' for 'ils':", "options": ["ils finient", "ils finissent", "ils finissons", "ils finit"], "correctIndex": 1, "explanation": "'Ils finissent' = they finish. Ils/elles → -issent.", "tags": ["finir-ils"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-005", "question": "Complete: 'Nous ___ nos devoirs.' (finir — we finish our homework)", "options": ["finissons", "finons", "finissez", "finissent"], "correctIndex": 0, "explanation": "'Nous finissons nos devoirs.' Nous → -issons.", "tags": ["finir-nous"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-006", "question": "Complete: 'Les enfants ___ vite.' (grandir — the children grow fast)", "options": ["grandit", "grandissons", "grandissent", "grandissez"], "correctIndex": 2, "explanation": "'Les enfants grandissent vite.' Ils/elles → -issent.", "tags": ["grandir-ils"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-007", "question": "Complete: 'Vous ___ un film.' (choisir — you choose a film)", "options": ["choisissez", "choisissons", "choisit", "choisissent"], "correctIndex": 0, "explanation": "'Vous choisissez un film.' Vous → -issez.", "tags": ["choisir-vous"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-008", "question": "What does 'réfléchir' mean?", "options": ["To shine", "To think / to reflect", "To finish", "To grow"], "correctIndex": 1, "explanation": "'Réfléchir' = to think / to reflect. 'Nous réfléchissons.' = We are thinking.", "tags": ["reflechir"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-009", "question": "Complete: 'Nous ___ à la question.' (réfléchir — we think about the question)", "options": ["réfléchit", "réfléchissons", "réfléchissez", "réfléchissent"], "correctIndex": 1, "explanation": "'Nous réfléchissons à la question.' Nous → -issons.", "tags": ["reflechir-nous"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-010", "question": "What does 'remplir' mean?", "options": ["To empty", "To fill", "To finish", "To choose"], "correctIndex": 1, "explanation": "'Remplir' = to fill. 'Je remplis le verre.' = I fill the glass.", "tags": ["remplir"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-011", "question": "Complete: 'Ils ___ leurs verres.' (remplir — they fill their glasses)", "options": ["remplit", "remplissons", "remplissent", "remplissez"], "correctIndex": 2, "explanation": "'Ils remplissent leurs verres.' Ils → -issent.", "tags": ["remplir-ils"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-012", "question": "Which form is for 'vous'?", "options": ["finissons", "finissez", "finissent", "finit"], "correctIndex": 1, "explanation": "'Vous' takes -issez: vous finissez.", "tags": ["ending-match"], "conceptLevel": 2 },
    { "id": "g4f-w23-tue-013", "question": "Complete the full plural set of 'choisir': nous ___, vous choisissez, ils choisissent", "options": ["choisons", "choisissons", "choisissez", "choisit"], "correctIndex": 1, "explanation": "Nous choisissons, vous choisissez, ils choisissent — all plural forms have -iss-.", "tags": ["full-plural"], "conceptLevel": 2 },
    { "id": "g4f-w23-tue-014", "question": "What does 'applaudir' mean?", "options": ["To clap / to applaud", "To finish", "To choose", "To fill"], "correctIndex": 0, "explanation": "'Applaudir' = to clap / to applaud. 'Ils applaudissent.' = They applaud.", "tags": ["applaudir"], "conceptLevel": 1 },
    { "id": "g4f-w23-tue-015", "question": "Complete: 'Le public ___.' (applaudir — the audience applauds)", "options": ["applaudissent", "applaudit", "applaudissez", "applaudis"], "correctIndex": 1, "explanation": "'Le public applaudit.' — 'public' is singular (il), so → -it.", "tags": ["applaudir-il"], "conceptLevel": 2 }
