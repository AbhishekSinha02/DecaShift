    { "id": "g6m-w21-wed-001", "question": "Calculate: (−5) + (−3)", "options": ["−8", "8", "2", "−2"], "correctIndex": 0, "explanation": "Adding two negatives: add the magnitudes, keep negative sign. 5 + 3 = 8 → −8.", "tags": ["integers", "addition", "negative"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-002", "question": "Calculate: 6 + (−4)", "options": ["−10", "10", "2", "−2"], "correctIndex": 2, "explanation": "6 + (−4) = 6 − 4 = 2. The positive is larger, so result is positive.", "tags": ["integers", "addition", "mixed"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-003", "question": "Calculate: (−7) + 3", "options": ["4", "−4", "10", "−10"], "correctIndex": 1, "explanation": "(−7) + 3 = −(7 − 3) = −4. Negative is larger, result is negative.", "tags": ["integers", "addition", "mixed"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-004", "question": "Calculate: 5 − 8", "options": ["3", "13", "−3", "−13"], "correctIndex": 2, "explanation": "5 − 8 = 5 + (−8) = −3. On number line, start at 5 and go 8 steps left.", "tags": ["integers", "subtraction"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-005", "question": "Calculate: (−9) − (−4)", "options": ["−13", "−5", "5", "13"], "correctIndex": 1, "explanation": "Subtracting a negative = adding positive: (−9) − (−4) = −9 + 4 = −5.", "tags": ["integers", "subtraction-negative"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-006", "question": "Calculate: (−12) + (−8) + 5", "options": ["−25", "−15", "15", "25"], "correctIndex": 1, "explanation": "(−12) + (−8) = −20. Then −20 + 5 = −15.", "tags": ["integers", "three-terms"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-007", "question": "Calculate: 0 − (−7)", "options": ["−7", "0", "7", "70"], "correctIndex": 2, "explanation": "0 − (−7) = 0 + 7 = 7.", "tags": ["integers", "zero-subtraction"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-008", "question": "A diver is at −30 m. He rises 12 m. What is his new depth?", "options": ["−42 m", "−18 m", "18 m", "42 m"], "correctIndex": 1, "explanation": "−30 + 12 = −18 m. He is still 18 m below surface.", "tags": ["integers", "word-problem", "addition"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-009", "question": "Calculate: (−6) − (+9)", "options": ["3", "−3", "15", "−15"], "correctIndex": 3, "explanation": "(−6) − (+9) = −6 − 9 = −15.", "tags": ["integers", "subtraction"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-010", "question": "Temperature went from −5°C to −12°C. How did it change?", "options": ["Increased by 7°C", "Decreased by 7°C", "Increased by 17°C", "Decreased by 17°C"], "correctIndex": 1, "explanation": "Change = −12 − (−5) = −12 + 5 = −7. Negative means it decreased by 7°C.", "tags": ["integers", "real-life", "subtraction"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-011", "question": "Calculate: (−15) + 15", "options": ["0", "30", "−30", "15"], "correctIndex": 0, "explanation": "Any integer plus its opposite = 0. (−15) + 15 = 0.", "tags": ["integers", "additive-inverse"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-012", "question": "Calculate: 4 − 9 + 3 − 2", "options": ["−4", "4", "−8", "18"], "correctIndex": 0, "explanation": "4 − 9 = −5. −5 + 3 = −2. −2 − 2 = −4.", "tags": ["integers", "mixed-operations"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-013", "question": "A team loses 3 points, then gains 7 points, then loses 5 points. Net change from 0?", "options": ["−1", "1", "15", "−15"], "correctIndex": 0, "explanation": "(−3) + 7 + (−5) = −3 + 7 − 5 = 4 − 5 = −1.", "tags": ["integers", "word-problem", "points"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-014", "question": "Calculate: (−3) + (−3) + (−3) + (−3)", "options": ["−9", "9", "−12", "12"], "correctIndex": 2, "explanation": "Four times (−3) = −12. Adding 4 equal negatives = 4 × (−3) = −12.", "tags": ["integers", "repeated-addition"], "conceptLevel": 2 },
    { "id": "g6m-w21-wed-015", "question": "What must be added to −8 to get 5?", "options": ["−13", "13", "3", "−3"], "correctIndex": 1, "explanation": "−8 + ? = 5. ? = 5 − (−8) = 5 + 8 = 13.", "tags": ["integers", "missing-number"], "conceptLevel": 2 }
