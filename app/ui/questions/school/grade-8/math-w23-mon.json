    { "id": "g8m-w23-mon-001", "question": "The square of 7 is ___.", "options": ["14", "49", "42", "21"], "correctIndex": 1, "explanation": "7² = 7 × 7 = 49.", "tags": ["squares"] },
    { "id": "g8m-w23-mon-002", "question": "A perfect square is a number that is the square of a ___.", "options": ["Fraction", "Whole number", "Decimal", "Negative"], "correctIndex": 1, "explanation": "A perfect square is the square of a whole number, e.g. 16 = 4².", "tags": ["squares", "concept"] },
    { "id": "g8m-w23-mon-003", "question": "Which of these is a perfect square?", "options": ["18", "24", "36", "40"], "correctIndex": 2, "explanation": "36 = 6². The others are not perfect squares.", "tags": ["squares"] },
    { "id": "g8m-w23-mon-004", "question": "12² = ?", "options": ["124", "144", "122", "121"], "correctIndex": 1, "explanation": "12 × 12 = 144.", "tags": ["squares"] },
    { "id": "g8m-w23-mon-005", "question": "A perfect square never ends in ___.", "options": ["1 or 9", "4 or 6", "2, 3, 7 or 8", "0 or 5"], "correctIndex": 2, "explanation": "Squares never end in 2, 3, 7 or 8.", "tags": ["squares", "property"] },
