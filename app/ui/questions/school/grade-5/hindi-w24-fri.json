    { "id": "g5h-w24-fri-002", "question": "'वह अभी घर पर है।' — 'अभी' का प्रकार:", "options": ["स्थानवाचक", "कालवाचक", "रीतिवाचक", "परिमाणवाचक"], "correctIndex": 1, "explanation": "'अभी' = इस समय (कब?) — कालवाचक।", "tags": ["review"], "conceptLevel": 0 },
