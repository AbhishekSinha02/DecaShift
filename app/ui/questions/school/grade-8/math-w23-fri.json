    { "id": "g8m-w23-fri-014", "question": "A perfect square between 90 and 110 is ___.", "options": ["96", "100", "105", "108"], "correctIndex": 1, "explanation": "100 = 10² is the perfect square in that range.", "tags": ["squares"] },
