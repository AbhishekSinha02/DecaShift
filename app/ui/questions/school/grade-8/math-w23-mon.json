    { "id": "g8m-w23-mon-007", "question": "Which is NOT a perfect square?", "options": ["64", "81", "90", "100"], "correctIndex": 2, "explanation": "90 is not a perfect square; 64=8², 81=9², 100=10².", "tags": ["squares"] },
    { "id": "g8m-w23-mon-008", "question": "The square of an even number is always ___.", "options": ["Odd", "Even", "Prime", "Zero"], "correctIndex": 1, "explanation": "Even × even = even, so the square is even.", "tags": ["squares", "property"] },
    { "id": "g8m-w23-mon-009", "question": "13² = ?", "options": ["156", "169", "163", "159"], "correctIndex": 1, "explanation": "13 × 13 = 169.", "tags": ["squares"] },
