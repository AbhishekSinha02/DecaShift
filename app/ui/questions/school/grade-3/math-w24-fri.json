  "questions": [
    { "id": "g3m-w24-fri-001", "question": "What fraction of a week is 1 day?", "options": ["1/5", "1/7", "1/6", "1/4"], "correctIndex": 1, "explanation": "There are 7 days in a week. 1 day = 1/7 of a week.", "tags": ["fractions", "real-life"] },
    { "id": "g3m-w24-fri-002", "question": "A third of 18 + a quarter of 8 = ___.", "options": ["8", "6", "8", "5"], "correctIndex": 0, "explanation": "1/3 of 18 = 6. 1/4 of 8 = 2. 6 + 2 = 8.", "tags": ["fractions", "mixed-operations"] },
    { "id": "g3m-w24-fri-003", "question": "What fraction of 10 is 5?", "options": ["1/5", "1/4", "1/2", "1/3"], "correctIndex": 2, "explanation": "5 out of 10 = 5/10 = 1/2.", "tags": ["fractions", "1/2"] },
    { "id": "g3m-w24-fri-004", "question": "A bag has 20 marbles. 5 are red. What fraction are red?", "options": ["1/5", "1/4", "5/10", "4/5"], "correctIndex": 1, "explanation": "5 out of 20 = 5/20 = 1/4.", "tags": ["fractions", "word-problem"] },
    { "id": "g3m-w24-fri-005", "question": "Half of 34 is ___.", "options": ["12", "16", "17", "14"], "correctIndex": 2, "explanation": "34 ÷ 2 = 17.", "tags": ["fractions", "half"] },
    { "id": "g3m-w24-fri-006", "question": "Pooja read 2/5 of a 20-page book. How many pages did she read?", "options": ["4", "6", "8", "10"], "correctIndex": 2, "explanation": "2/5 of 20 = (20 ÷ 5) × 2 = 4 × 2 = 8 pages.", "tags": ["fractions", "word-problem"] },
    { "id": "g3m-w24-fri-007", "question": "3/4 of 40 = ___.", "options": ["10", "20", "30", "40"], "correctIndex": 2, "explanation": "1/4 of 40 = 10. 3/4 = 3 × 10 = 30.", "tags": ["fractions", "3/4"] },
    { "id": "g3m-w24-fri-008", "question": "A train journey is 6 hours. Mira slept for 2 hours. What fraction of the journey did she sleep?", "options": ["1/6", "1/3", "2/4", "3/6"], "correctIndex": 1, "explanation": "2 out of 6 = 2/6 = 1/3.", "tags": ["fractions", "real-life"] },
    { "id": "g3m-w24-fri-009", "question": "Which is closest to 1 whole?", "options": ["1/4", "3/4", "1/2", "3/8"], "correctIndex": 1, "explanation": "3/4 = 0.75, closest to 1. 1/2 = 0.5, 3/8 = 0.375, 1/4 = 0.25.", "tags": ["fractions", "comparing"] },
    { "id": "g3m-w24-fri-010", "question": "A class of 30 children has 10 absent. What fraction is present?", "options": ["1/3", "2/3", "1/2", "3/10"], "correctIndex": 1, "explanation": "Present = 30 − 10 = 20. 20/30 = 2/3.", "tags": ["fractions", "word-problem"] },
    { "id": "g3m-w24-fri-011", "question": "1/4 of ___ = 5.", "options": ["10", "15", "20", "25"], "correctIndex": 2, "explanation": "If 1/4 of a number is 5, the number = 5 × 4 = 20.", "tags": ["fractions", "missing-number"] },
    { "id": "g3m-w24-fri-012", "question": "What fraction of 100 is 25?", "options": ["1/5", "1/4", "1/2", "1/3"], "correctIndex": 1, "explanation": "25 out of 100 = 25/100 = 1/4.", "tags": ["fractions", "1/4"] },
    { "id": "g3m-w24-fri-013", "question": "Farhan solved 3/4 of 24 questions. How many did he solve?", "options": ["6", "12", "18", "20"], "correctIndex": 2, "explanation": "1/4 of 24 = 6. 3/4 = 3 × 6 = 18 questions.", "tags": ["fractions", "word-problem"] },
    { "id": "g3m-w24-fri-014", "question": "2/3 of 15 = ___.", "options": ["5", "8", "10", "12"], "correctIndex": 2, "explanation": "1/3 of 15 = 5. 2/3 = 2 × 5 = 10.", "tags": ["fractions", "2/3"] },
    { "id": "g3m-w24-fri-015", "question": "Which fraction equals the same as 50 out of 100?", "options": ["1/4", "3/4", "1/2", "1/5"], "correctIndex": 2, "explanation": "50/100 = 1/2. Dividing both by 50: 50÷50 = 1, 100÷50 = 2.", "tags": ["fractions", "equivalent"] }
  ]
