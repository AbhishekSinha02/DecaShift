  "questions": [
    { "id": "g7m-w22-tue-001", "question": "What is transposition in solving equations?", "options": ["Multiplying both sides by the same number", "Moving a term to the other side by changing its sign", "Swapping LHS and RHS", "Adding zero to both sides"], "correctIndex": 1, "explanation": "Transposition means moving a term to the opposite side of the equation and changing its sign (+→− or ×→÷).", "tags": ["linear-equations", "transposition"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-002", "question": "Solve: 4x = 28", "options": ["4", "6", "7", "112"], "correctIndex": 2, "explanation": "Divide both sides by 4: x = 28 ÷ 4 = 7.", "tags": ["linear-equations", "multiplication-equation"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-003", "question": "Solve: x/5 = 6", "options": ["1.2", "11", "30", "0.83"], "correctIndex": 2, "explanation": "Multiply both sides by 5: x = 6 × 5 = 30.", "tags": ["linear-equations", "division-equation"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-004", "question": "Using transposition, solve: y − 9 = 13", "options": ["4", "9", "22", "13"], "correctIndex": 2, "explanation": "Transpose −9 to RHS (it becomes +9): y = 13 + 9 = 22.", "tags": ["linear-equations", "transposition"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-005", "question": "Solve: 3m = 27", "options": ["3", "9", "24", "81"], "correctIndex": 1, "explanation": "m = 27 ÷ 3 = 9.", "tags": ["linear-equations", "multiplication-equation"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-006", "question": "Solve: a/7 = 4", "options": ["0.57", "11", "28", "3"], "correctIndex": 2, "explanation": "a = 4 × 7 = 28.", "tags": ["linear-equations", "division-equation"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-007", "question": "Solve: 5t = 45", "options": ["8", "9", "40", "225"], "correctIndex": 1, "explanation": "t = 45 ÷ 5 = 9.", "tags": ["linear-equations", "multiplication-equation"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-008", "question": "Using transposition, solve: n + 18 = 30", "options": ["12", "18", "48", "540"], "correctIndex": 0, "explanation": "Transpose +18 to RHS (it becomes −18): n = 30 − 18 = 12.", "tags": ["linear-equations", "transposition"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-009", "question": "Solve: x/3 = 9", "options": ["3", "12", "27", "6"], "correctIndex": 2, "explanation": "x = 9 × 3 = 27.", "tags": ["linear-equations", "division-equation"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-010", "question": "Which first step correctly solves 6y = 42?", "options": ["Subtract 6 from both sides", "Divide both sides by 6", "Add 6 to both sides", "Multiply both sides by 6"], "correctIndex": 1, "explanation": "Divide both sides by 6 to isolate y: y = 42 ÷ 6 = 7.", "tags": ["linear-equations", "strategy"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-011", "question": "Solve: p − 23 = 15", "options": ["8", "15", "38", "345"], "correctIndex": 2, "explanation": "Transpose −23: p = 15 + 23 = 38.", "tags": ["linear-equations", "transposition"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-012", "question": "Solve: q/8 = 5", "options": ["1.6", "13", "40", "3"], "correctIndex": 2, "explanation": "q = 5 × 8 = 40.", "tags": ["linear-equations", "division-equation"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-013", "question": "Solve: 9r = 72", "options": ["7", "8", "63", "648"], "correctIndex": 1, "explanation": "r = 72 ÷ 9 = 8.", "tags": ["linear-equations", "multiplication-equation"], "conceptLevel": 1 },
    { "id": "g7m-w22-tue-014", "question": "When +7 is transposed from LHS to RHS, it becomes:", "options": ["−7", "+7", "×7", "0"], "correctIndex": 0, "explanation": "Transposition changes the sign: addition (+) becomes subtraction (−) when moved to the other side.", "tags": ["linear-equations", "transposition-rule"], "conceptLevel": 1 },
