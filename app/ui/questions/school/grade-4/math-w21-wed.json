  "questions": [
    { "id": "g4m-w21-wed-001", "question": "1/5 + 2/5 = ?", "options": ["3/5", "3/10", "2/5", "1/5"], "correctIndex": 0, "explanation": "When denominators are the same, just add numerators: 1 + 2 = 3. Denominator stays 5. Answer: 3/5.", "tags": ["add-same-denom"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-002", "question": "3/7 + 2/7 = ?", "options": ["5/14", "5/7", "6/7", "1/7"], "correctIndex": 1, "explanation": "3 + 2 = 5, denominator stays 7. Answer: 5/7.", "tags": ["add-same-denom-2"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-003", "question": "5/8 - 3/8 = ?", "options": ["2/0", "2/8", "8/8", "2/16"], "correctIndex": 1, "explanation": "Subtract numerators: 5 - 3 = 2. Denominator stays 8. Answer: 2/8 (simplifies to 1/4).", "tags": ["subtract-same-denom"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-004", "question": "4/9 + 3/9 = ?", "options": ["7/9", "7/18", "1", "7/0"], "correctIndex": 0, "explanation": "4 + 3 = 7, denominator stays 9. Answer: 7/9.", "tags": ["add-ninths"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-005", "question": "6/10 - 2/10 = ?", "options": ["4/20", "8/10", "4/10", "4/0"], "correctIndex": 2, "explanation": "6 - 2 = 4, denominator stays 10. Answer: 4/10 (simplifies to 2/5).", "tags": ["subtract-tenths"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-006", "question": "3/4 + 1/4 = ?", "options": ["4/8", "4/4 = 1", "4/16", "1/4"], "correctIndex": 1, "explanation": "3 + 1 = 4, denominator stays 4. 4/4 = 1 whole.", "tags": ["add-to-whole"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-007", "question": "Riya ate 2/6 of a cake and her brother ate 1/6. How much was eaten in total?", "options": ["3/6 = 1/2", "3/12", "2/6", "1/6"], "correctIndex": 0, "explanation": "2/6 + 1/6 = 3/6 = 1/2. Half the cake was eaten.", "tags": ["word-problem-add"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-008", "question": "1 - 3/5 = ?", "options": ["3/5", "2/5", "1/5", "4/5"], "correctIndex": 1, "explanation": "1 = 5/5. 5/5 - 3/5 = 2/5.", "tags": ["subtract-from-whole"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-009", "question": "7/12 - 4/12 = ?", "options": ["3/0", "11/12", "3/12", "3/24"], "correctIndex": 2, "explanation": "7 - 4 = 3, denominator stays 12. Answer: 3/12 (simplifies to 1/4).", "tags": ["subtract-twelfths"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-010", "question": "A jug holds 8/10 of water. 3/10 spills. How much is left?", "options": ["5/10", "11/10", "5/20", "8/10"], "correctIndex": 0, "explanation": "8/10 - 3/10 = 5/10 = 1/2. Half the jug is left.", "tags": ["word-problem-subtract"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-011", "question": "2/3 + 2/3 = ?", "options": ["4/6", "4/3", "2/3", "1"], "correctIndex": 1, "explanation": "2 + 2 = 4, denominator stays 3. Answer: 4/3 (an improper fraction — more than 1 whole).", "tags": ["add-improper-result"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-012", "question": "Which property allows: 1/5 + 2/5 = 2/5 + 1/5?", "options": ["Associative", "Commutative", "Distributive", "Additive identity"], "correctIndex": 1, "explanation": "Commutative property: a + b = b + a. Works for fractions too!", "tags": ["commutative-fractions"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-013", "question": "5/6 - 5/6 = ?", "options": ["1", "10/6", "0/6 = 0", "5/6"], "correctIndex": 2, "explanation": "5 - 5 = 0, denominator stays 6. 0/6 = 0. A number minus itself is always 0!", "tags": ["fraction-minus-itself"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-014", "question": "Arjun drank 1/4 litre of milk in the morning and 2/4 litre in the evening. Total?", "options": ["3/8", "3/4", "1/4", "2/4"], "correctIndex": 1, "explanation": "1/4 + 2/4 = 3/4 litre total.", "tags": ["daily-milk-add"], "conceptLevel": 2 },
    { "id": "g4m-w21-wed-015", "question": "What must be the same when adding or subtracting fractions (for the simple method)?", "options": ["Numerators must be the same", "Denominators must be the same", "The fractions must be proper", "Nothing needs to match"], "correctIndex": 1, "explanation": "When denominators are the same, just add/subtract numerators. If denominators differ, first find a common denominator.", "tags": ["fraction-add-rule"], "conceptLevel": 2 }
  ]
