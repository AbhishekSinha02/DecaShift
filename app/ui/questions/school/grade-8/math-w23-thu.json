    { "id": "g8m-w23-thu-001", "question": "By prime factorisation, 36 = 2×2×3×3, so √36 = ___.", "options": ["4", "6", "9", "12"], "correctIndex": 1, "explanation": "Pair the primes: (2×3) = 6, so √36 = 6.", "tags": ["prime-factorisation"] },
