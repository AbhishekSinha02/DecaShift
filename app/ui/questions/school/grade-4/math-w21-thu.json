  "questions": [
    { "id": "g4m-w21-thu-001", "question": "An improper fraction has numerator ___ denominator.", "options": ["Less than", "Equal to (only)", "Greater than or equal to", "Less than or equal to"], "correctIndex": 2, "explanation": "Improper fractions have numerator ≥ denominator: 5/3, 7/4, 8/8 are all improper.", "tags": ["improper-definition"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-002", "question": "Convert 7/3 to a mixed number.", "options": ["2 and 1/3", "2 and 2/3", "3 and 1/7", "1 and 4/3"], "correctIndex": 0, "explanation": "7 ÷ 3 = 2 remainder 1. So 7/3 = 2 and 1/3 (two wholes and one third).", "tags": ["improper-to-mixed"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-003", "question": "Convert 11/4 to a mixed number.", "options": ["2 and 3/4", "3 and 2/4", "2 and 1/4", "4 and 3/11"], "correctIndex": 0, "explanation": "11 ÷ 4 = 2 remainder 3. So 11/4 = 2 and 3/4.", "tags": ["improper-to-mixed-2"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-004", "question": "Convert 1 and 2/5 to an improper fraction.", "options": ["3/5", "7/5", "2/5", "12/5"], "correctIndex": 1, "explanation": "1 and 2/5: multiply whole (1) × denominator (5) + numerator (2) = 7. Denominator stays 5. Answer: 7/5.", "tags": ["mixed-to-improper"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-005", "question": "Convert 3 and 1/4 to an improper fraction.", "options": ["13/4", "7/4", "12/4", "3/4"], "correctIndex": 0, "explanation": "3 × 4 + 1 = 13. Denominator stays 4. Answer: 13/4.", "tags": ["mixed-to-improper-2"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-006", "question": "Which of these is an improper fraction?", "options": ["3/4", "2/5", "1/9", "9/5"], "correctIndex": 3, "explanation": "9/5 has numerator (9) > denominator (5) — it's improper. All others have numerator < denominator.", "tags": ["identify-improper"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-007", "question": "Convert 9/4 to a mixed number.", "options": ["2 and 1/4", "2 and 2/4", "1 and 5/4", "3 and 1/4"], "correctIndex": 0, "explanation": "9 ÷ 4 = 2 remainder 1. So 9/4 = 2 and 1/4.", "tags": ["9-4-mixed"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-008", "question": "A baker makes 2 and 3/8 pies. How many eighths is that in total?", "options": ["11/8", "19/8", "16/8", "5/8"], "correctIndex": 1, "explanation": "2 × 8 + 3 = 19. So 2 and 3/8 = 19/8 eighths.", "tags": ["mixed-to-improper-word"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-009", "question": "Convert 15/6 to a mixed number in simplest form.", "options": ["2 and 3/6 = 2 and 1/2", "2 and 1/6", "1 and 9/6", "3 and 1/2"], "correctIndex": 0, "explanation": "15 ÷ 6 = 2 remainder 3. So 15/6 = 2 and 3/6 = 2 and 1/2 (simplify 3/6 → 1/2).", "tags": ["improper-to-mixed-simplify"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-010", "question": "Which is greater: 7/3 or 2 and 1/4?", "options": ["7/3 is greater", "2 and 1/4 is greater", "They are equal", "Cannot compare"], "correctIndex": 1, "explanation": "7/3 = 2.33... and 2 and 1/4 = 2.25. Wait — 7/3 ≈ 2.33 > 2.25. So 7/3 is greater.", "tags": ["compare-mixed-improper"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-011", "question": "Convert 4 and 2/3 to an improper fraction.", "options": ["6/3", "14/3", "10/3", "12/3"], "correctIndex": 1, "explanation": "4 × 3 + 2 = 14. Denominator stays 3. Answer: 14/3.", "tags": ["mixed-to-improper-3"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-012", "question": "How many halves (1/2) are in 3 wholes?", "options": ["3", "4", "6", "5"], "correctIndex": 2, "explanation": "3 wholes = 3/1 = 6/2. There are 6 halves in 3 wholes.", "tags": ["wholes-to-halves"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-013", "question": "Convert 5/5 to a whole or mixed number.", "options": ["0", "5", "2", "1"], "correctIndex": 3, "explanation": "5/5 = 1. Any fraction where numerator = denominator equals 1 whole.", "tags": ["equal-fraction-whole"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-014", "question": "Riya has 2 and 1/2 apples. She gives 1/2 apple. How many apples are left?", "options": ["2 apples", "1 and 1/2 apples", "2 and 1/2 apples", "1 apple"], "correctIndex": 0, "explanation": "2 and 1/2 - 1/2 = 2. The halves cancel out, leaving exactly 2 whole apples.", "tags": ["mixed-subtract-fraction"], "conceptLevel": 2 },
    { "id": "g4m-w21-thu-015", "question": "Which is the largest: 5/3, 7/4, or 2?", "options": ["5/3", "7/4", "2", "They are all equal"], "correctIndex": 2, "explanation": "5/3 ≈ 1.67, 7/4 = 1.75, 2 = 2/1 = 2.00. So 2 is the largest.", "tags": ["compare-three-values"], "conceptLevel": 2 }
  ]
