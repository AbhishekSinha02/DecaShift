    { "id": "g3m-w23-tue-001", "question": "12 − 4 − 4 − 4 = 0. So 12 ÷ 4 = ?", "options": ["2", "3", "4", "6"], "correctIndex": 1, "explanation": "We subtracted 4 three times, so 12 ÷ 4 = 3.", "tags": ["repeated-subtraction"] },
    { "id": "g3m-w23-tue-002", "question": "How many times can you subtract 2 from 10?", "options": ["3", "4", "5", "6"], "correctIndex": 2, "explanation": "10 ÷ 2 = 5, so you can subtract 2 five times.", "tags": ["repeated-subtraction"] },
    { "id": "g3m-w23-tue-003", "question": "15 − 5 − 5 − 5 = 0. This shows 15 ÷ 5 = ?", "options": ["2", "3", "4", "5"], "correctIndex": 1, "explanation": "5 was subtracted 3 times, so 15 ÷ 5 = 3.", "tags": ["repeated-subtraction"] },
    { "id": "g3m-w23-tue-004", "question": "Division is the opposite (inverse) of ___.", "options": ["Addition", "Subtraction", "Multiplication", "Counting"], "correctIndex": 2, "explanation": "Division undoes multiplication: 3 × 4 = 12 and 12 ÷ 4 = 3.", "tags": ["inverse"] },
    { "id": "g3m-w23-tue-005", "question": "If 4 × 6 = 24, then 24 ÷ 6 = ?", "options": ["4", "6", "8", "24"], "correctIndex": 0, "explanation": "Division undoes multiplication, so 24 ÷ 6 = 4.", "tags": ["inverse"] },
    { "id": "g3m-w23-tue-006", "question": "How many times can you subtract 3 from 12?", "options": ["3", "4", "5", "6"], "correctIndex": 1, "explanation": "12 ÷ 3 = 4, so 3 can be subtracted 4 times.", "tags": ["repeated-subtraction"] },
    { "id": "g3m-w23-tue-007", "question": "If 5 × 5 = 25, then 25 ÷ 5 = ?", "options": ["4", "5", "6", "10"], "correctIndex": 1, "explanation": "25 ÷ 5 = 5, the inverse of 5 × 5.", "tags": ["inverse"] },
