    { "id": "g3h-w21-fri-011", "question": "प्रदूषण किससे होता है?", "options": ["पेड़ लगाने से", "नदी में कूड़ा फेंकने और धुआँ फैलाने से", "साफ पानी पीने से", "पैदल चलने से"], "correctIndex": 1, "explanation": "नदियों में कूड़ा फेंकने और वाहनों/कारखानों से धुआँ निकलने से प्रदूषण (pollution) होता है।", "tags": ["environment"] },
    { "id": "g3h-w21-fri-012", "question": "भारत का 'राष्ट्रीय पक्षी' (National Bird) है:", "options": ["कोयल", "तोता", "मोर", "बाज़"], "correctIndex": 2, "explanation": "भारत का राष्ट्रीय पक्षी 'मोर' (Peacock) है।", "tags": ["nature", "general-knowledge"] },
