    { "id": "g6m-w22-wed-001", "question": "Simplify: 3x + 5x", "options": ["8x", "8x²", "15x", "8"], "correctIndex": 0, "explanation": "3x + 5x = (3+5)x = 8x. We add only the coefficients of like terms.", "tags": ["algebra", "adding-like-terms"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-002", "question": "Simplify: 7y − 4y", "options": ["3", "3y", "11y", "28y"], "correctIndex": 1, "explanation": "7y − 4y = (7−4)y = 3y.", "tags": ["algebra", "subtracting-like-terms"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-003", "question": "Simplify: 4a + 3b + 2a", "options": ["9ab", "6a + 3b", "4a + 5b", "9a + 3b"], "correctIndex": 1, "explanation": "Combine like terms: 4a + 2a = 6a. 3b stays as is. Answer: 6a + 3b.", "tags": ["algebra", "combining-like-terms"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-004", "question": "Add the expressions (2x + 3) and (4x + 7)", "options": ["6x + 10", "8x + 10", "6x + 4", "6x² + 10"], "correctIndex": 0, "explanation": "2x + 4x = 6x. 3 + 7 = 10. Answer: 6x + 10.", "tags": ["algebra", "adding-expressions"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-005", "question": "Subtract: (5p + 8) − (2p + 3)", "options": ["3p + 5", "3p + 11", "7p + 5", "7p + 11"], "correctIndex": 0, "explanation": "5p − 2p = 3p. 8 − 3 = 5. Answer: 3p + 5.", "tags": ["algebra", "subtracting-expressions"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-006", "question": "Simplify: 9m − 3m + 2m", "options": ["4m", "8m", "14m", "−4m"], "correctIndex": 1, "explanation": "Work left to right: 9m − 3m = 6m. 6m + 2m = 8m.", "tags": ["algebra", "combining-like-terms"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-007", "question": "Simplify: 6x + 4y − 2x + y", "options": ["4x + 5y", "8x + 5y", "4x + 3y", "4xy"], "correctIndex": 0, "explanation": "x terms: 6x − 2x = 4x. y terms: 4y + y = 5y. Answer: 4x + 5y.", "tags": ["algebra", "two-variables"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-008", "question": "What is (3a + 2b + 5) + (a − b + 3)?", "options": ["4a + b + 8", "4a + 3b + 8", "3a + b + 8", "4a + b + 2"], "correctIndex": 0, "explanation": "a terms: 3a + a = 4a. b terms: 2b + (−b) = b. Constants: 5 + 3 = 8. Answer: 4a + b + 8.", "tags": ["algebra", "adding-expressions", "two-variables"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-009", "question": "Simplify: 5x + 3 − 2x − 7", "options": ["3x − 4", "3x + 10", "7x − 4", "3x + 4"], "correctIndex": 0, "explanation": "x terms: 5x − 2x = 3x. Constants: 3 − 7 = −4. Answer: 3x − 4.", "tags": ["algebra", "simplification"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-010", "question": "Can we add 3x and 4x²?", "options": ["Yes, answer is 7x³", "Yes, answer is 7x²", "No, they are unlike terms", "Yes, answer is 12x²"], "correctIndex": 2, "explanation": "3x (power 1) and 4x² (power 2) are unlike terms. We CANNOT add unlike terms.", "tags": ["algebra", "unlike-terms", "cannot-add"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-011", "question": "A rectangle has length (3x + 2) cm and width (x + 5) cm. What is its perimeter?", "options": ["4x + 7", "8x + 14", "3x² + 17x + 10", "6x + 4"], "correctIndex": 1, "explanation": "Perimeter = 2 × (length + width) = 2 × (3x+2 + x+5) = 2 × (4x+7) = 8x + 14.", "tags": ["algebra", "perimeter", "word-problem"], "conceptLevel": 3 },
    { "id": "g6m-w22-wed-012", "question": "Simplify: 8n + 4 − 3n − 4", "options": ["5n", "5n + 8", "11n", "5n − 8"], "correctIndex": 0, "explanation": "n terms: 8n − 3n = 5n. Constants: 4 − 4 = 0. Answer: 5n.", "tags": ["algebra", "simplification"], "conceptLevel": 2 },
    { "id": "g6m-w22-wed-013", "question": "What is (7z − 3) − (4z − 1)?", "options": ["3z − 2", "3z − 4", "11z − 4", "3z + 4"], "correctIndex": 0, "explanation": "Distribute the minus: 7z − 3 − 4z + 1. Then: 7z − 4z = 3z. −3 + 1 = −2. Answer: 3z − 2.", "tags": ["algebra", "subtracting-expressions", "brackets"], "conceptLevel": 2 },
