  "questions": [
    { "id": "g5m-w23-fri-001", "question": "Riya scored 45 out of 50. What percent is that?", "options": ["80%", "85%", "90%", "95%"], "correctIndex": 2, "explanation": "45/50 = 90/100 = 90%.", "tags": ["percentage", "word-problem"] },
    { "id": "g5m-w23-fri-002", "question": "A ₹800 bag has 25% off. The discount is ___.", "options": ["₹150", "₹200", "₹250", "₹600"], "correctIndex": 1, "explanation": "25% of 800 = 800 ÷ 4 = ₹200.", "tags": ["percentage", "money"] },
    { "id": "g5m-w23-fri-003", "question": "Average of 12, 16 and 20 is ___.", "options": ["14", "16", "18", "20"], "correctIndex": 1, "explanation": "(12 + 16 + 20) ÷ 3 = 48 ÷ 3 = 16.", "tags": ["average"] },
    { "id": "g5m-w23-fri-004", "question": "In a survey of 200 people, 30% like tea. How many like tea?", "options": ["30", "50", "60", "70"], "correctIndex": 2, "explanation": "30% of 200 = (30 ÷ 100) × 200 = 60.", "tags": ["percentage", "word-problem"] },
    { "id": "g5m-w23-fri-005", "question": "After a ₹200 discount on ₹800, the bag now costs ___.", "options": ["₹500", "₹600", "₹650", "₹700"], "correctIndex": 1, "explanation": "₹800 − ₹200 = ₹600.", "tags": ["percentage", "money"] },
    { "id": "g5m-w23-fri-006", "question": "A cricketer scores 40, 50, 60 in 3 matches. Average runs?", "options": ["40", "50", "60", "150"], "correctIndex": 1, "explanation": "(40 + 50 + 60) ÷ 3 = 150 ÷ 3 = 50.", "tags": ["average", "word-problem"] },
    { "id": "g5m-w23-fri-007", "question": "60% of the 30 students passed. How many passed?", "options": ["12", "15", "18", "20"], "correctIndex": 2, "explanation": "60% of 30 = (60 ÷ 100) × 30 = 18.", "tags": ["percentage", "word-problem"] },
    { "id": "g5m-w23-fri-008", "question": "50% as a fraction is ___.", "options": ["1/4", "1/3", "1/2", "2/3"], "correctIndex": 2, "explanation": "50/100 = 1/2.", "tags": ["percentage", "fraction"] },
    { "id": "g5m-w23-fri-009", "question": "Average of 100 and 0 is ___.", "options": ["0", "50", "100", "25"], "correctIndex": 1, "explanation": "(100 + 0) ÷ 2 = 50.", "tags": ["average"] },
    { "id": "g5m-w23-fri-010", "question": "A phone is 80% charged. What percent more to full?", "options": ["10%", "20%", "30%", "80%"], "correctIndex": 1, "explanation": "100% − 80% = 20% more.", "tags": ["percentage"] },
    { "id": "g5m-w23-fri-011", "question": "Out of 20 questions, Sam got 15 right. His percent score is ___.", "options": ["65%", "70%", "75%", "80%"], "correctIndex": 2, "explanation": "15/20 = 75/100 = 75%.", "tags": ["percentage", "word-problem"] },
    { "id": "g5m-w23-fri-012", "question": "Average weight of 25 kg, 30 kg, 35 kg is ___.", "options": ["28 kg", "30 kg", "32 kg", "35 kg"], "correctIndex": 1, "explanation": "(25 + 30 + 35) ÷ 3 = 90 ÷ 3 = 30 kg.", "tags": ["average", "word-problem"] },
    { "id": "g5m-w23-fri-013", "question": "10% of ₹50 is ___.", "options": ["₹5", "₹10", "₹15", "₹25"], "correctIndex": 0, "explanation": "10% of 50 = 50 ÷ 10 = ₹5.", "tags": ["percentage", "money"] },
    { "id": "g5m-w23-fri-014", "question": "Average of 7, 9, 11, 13 is ___.", "options": ["9", "10", "11", "12"], "correctIndex": 1, "explanation": "(7 + 9 + 11 + 13) ÷ 4 = 40 ÷ 4 = 10.", "tags": ["average"] },
    { "id": "g5m-w23-fri-015", "question": "A class of 50 has 90% present. How many are present?", "options": ["40", "42", "45", "48"], "correctIndex": 2, "explanation": "90% of 50 = (90 ÷ 100) × 50 = 45 present.", "tags": ["percentage", "word-problem"] }
  ]
