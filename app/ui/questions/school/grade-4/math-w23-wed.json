    { "id": "g4m-w23-wed-003", "question": "Compare 3/5 and 2/5. Which is greater?", "options": ["2/5", "3/5", "Equal", "Cannot tell"], "correctIndex": 1, "explanation": "Same denominator — the bigger numerator wins. 3/5 > 2/5.", "tags": ["comparison"] },
