    { "id": "g3m-w24-tue-010", "question": "4 quarters make ___ whole.", "options": ["1", "2", "3", "4"], "correctIndex": 0, "explanation": "4/4 = 1 whole. Four quarter-pieces make one complete whole.", "tags": ["fractions", "whole"] },
    { "id": "g3m-w24-tue-011", "question": "Half of 50 is ___.", "options": ["5", "10", "20", "25"], "correctIndex": 3, "explanation": "50 ÷ 2 = 25.", "tags": ["fractions", "half"] },
    { "id": "g3m-w24-tue-012", "question": "A quarter of 100 is ___.", "options": ["10", "20", "25", "50"], "correctIndex": 2, "explanation": "100 ÷ 4 = 25.", "tags": ["fractions", "quarter"] },
    { "id": "g3m-w24-tue-013", "question": "Seema has ₹40. She spends half of it. How much does she spend?", "options": ["₹10", "₹20", "₹30", "₹40"], "correctIndex": 1, "explanation": "Half of ₹40 = 40 ÷ 2 = ₹20.", "tags": ["fractions", "half", "word-problem"] },
