  "questions": [
    { "id": "g6m-w23-mon-001", "question": "A ratio compares two quantities by ___.", "options": ["Addition", "Division", "Subtraction", "Counting"], "correctIndex": 1, "explanation": "A ratio compares quantities using division — how many times one is of the other.", "tags": ["ratio", "concept"] },
    { "id": "g6m-w23-mon-002", "question": "The ratio of 3 boys to 5 girls is written as ___.", "options": ["3 + 5", "3 : 5", "3 − 5", "5 : 3"], "correctIndex": 1, "explanation": "The ratio is 3 : 5 (read 'three to five').", "tags": ["ratio", "notation"] },
    { "id": "g6m-w23-mon-003", "question": "The ratio 4 : 8 in simplest form is ___.", "options": ["1 : 2", "2 : 1", "1 : 4", "4 : 8"], "correctIndex": 0, "explanation": "Divide both by 4: 4 : 8 = 1 : 2.", "tags": ["ratio", "simplify"] },
    { "id": "g6m-w23-mon-004", "question": "In a ratio a : b, the quantities must be in the ___ unit.", "options": ["Different", "Same", "Bigger", "Metric"], "correctIndex": 1, "explanation": "Ratios compare like quantities in the same unit.", "tags": ["ratio", "rule"] },
    { "id": "g6m-w23-mon-005", "question": "The ratio of 6 to 9 simplifies to ___.", "options": ["2 : 3", "3 : 2", "1 : 3", "6 : 9"], "correctIndex": 0, "explanation": "Divide both by 3: 6 : 9 = 2 : 3.", "tags": ["ratio", "simplify"] },
    { "id": "g6m-w23-mon-006", "question": "A team has 5 batsmen and 6 bowlers. Ratio of batsmen to bowlers?", "options": ["6 : 5", "5 : 6", "5 : 11", "11 : 5"], "correctIndex": 1, "explanation": "Batsmen : bowlers = 5 : 6.", "tags": ["ratio", "word-problem"] },
    { "id": "g6m-w23-mon-007", "question": "The ratio 10 : 15 simplifies to ___.", "options": ["2 : 3", "3 : 2", "1 : 5", "10 : 15"], "correctIndex": 0, "explanation": "Divide both by 5: 10 : 15 = 2 : 3.", "tags": ["ratio", "simplify"] },
    { "id": "g6m-w23-mon-008", "question": "Order matters in a ratio. 2 : 3 is ___ 3 : 2.", "options": ["Equal to", "Different from", "Bigger than always", "The same as"], "correctIndex": 1, "explanation": "2 : 3 and 3 : 2 are different ratios — order matters.", "tags": ["ratio", "concept"] },
    { "id": "g6m-w23-mon-009", "question": "The ratio of 12 to 4 is ___.", "options": ["1 : 3", "3 : 1", "4 : 12", "12 : 4"], "correctIndex": 1, "explanation": "Divide both by 4: 12 : 4 = 3 : 1.", "tags": ["ratio", "simplify"] },
    { "id": "g6m-w23-mon-010", "question": "A ratio has no ___.", "options": ["Numbers", "Units", "Order", "Meaning"], "correctIndex": 1, "explanation": "A ratio is just a comparison — it has no units.", "tags": ["ratio", "concept"] },
    { "id": "g6m-w23-mon-011", "question": "In a class of 20 boys and 30 girls, boys : girls = ___.", "options": ["3 : 2", "2 : 3", "20 : 50", "1 : 2"], "correctIndex": 1, "explanation": "20 : 30 = 2 : 3 (divide both by 10).", "tags": ["ratio", "word-problem"] },
    { "id": "g6m-w23-mon-012", "question": "The ratio 9 : 12 in simplest form is ___.", "options": ["3 : 4", "4 : 3", "1 : 2", "9 : 12"], "correctIndex": 0, "explanation": "Divide both by 3: 9 : 12 = 3 : 4.", "tags": ["ratio", "simplify"] },
    { "id": "g6m-w23-mon-013", "question": "₹50 to ₹100 as a ratio is ___.", "options": ["1 : 2", "2 : 1", "5 : 10", "50 : 100"], "correctIndex": 0, "explanation": "50 : 100 = 1 : 2 (divide both by 50).", "tags": ["ratio", "money"] },
    { "id": "g6m-w23-mon-014", "question": "The ratio of 7 to 7 is ___.", "options": ["7 : 7", "1 : 1", "0 : 0", "2 : 1"], "correctIndex": 1, "explanation": "Equal quantities give 1 : 1.", "tags": ["ratio", "simplify"] },
    { "id": "g6m-w23-mon-015", "question": "To compare 1 m to 50 cm, first convert to ___.", "options": ["Different units", "The same unit", "Ratios", "Fractions"], "correctIndex": 1, "explanation": "Convert to the same unit: 1 m = 100 cm, so 100 : 50 = 2 : 1.", "tags": ["ratio", "units"] }
