    { "id": "g4m-w23-wed-005", "question": "Which is greater: 1/2 or 1/3?", "options": ["1/2", "1/3", "Equal", "Cannot tell"], "correctIndex": 0, "explanation": "Halves are bigger than thirds, so 1/2 > 1/3.", "tags": ["comparison"] },
