    { "id": "g2m-w21-wed-001", "question": "What is 17 + 5?", "options": ["20", "21", "22", "23"], "correctIndex": 2, "explanation": "17 + 5 = 22. Ones: 7 + 5 = 12. Write 2, carry 1. Tens: 1 + 1 (carried) = 2. Answer: 22.", "tags": ["carry"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-002", "question": "What is 28 + 7?", "options": ["33", "34", "35", "36"], "correctIndex": 2, "explanation": "28 + 7 = 35. Ones: 8 + 7 = 15. Write 5, carry 1. Tens: 2 + 1 = 3. Answer: 35.", "tags": ["carry"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-003", "question": "What is 36 + 18?", "options": ["52", "53", "54", "55"], "correctIndex": 2, "explanation": "36 + 18 = 54. Ones: 6 + 8 = 14. Write 4, carry 1. Tens: 3 + 1 + 1 = 5. Answer: 54.", "tags": ["2-digit-carry"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-004", "question": "Priya collects 47 stamps. Her brother gives her 25 more. How many stamps?", "options": ["70", "71", "72", "73"], "correctIndex": 2, "explanation": "47 + 25 = 72. Ones: 7 + 5 = 12. Write 2, carry 1. Tens: 4 + 2 + 1 = 7. Answer: 72.", "tags": ["word-problem", "carry"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-005", "question": "What is 54 + 29?", "options": ["81", "82", "83", "84"], "correctIndex": 2, "explanation": "54 + 29 = 83. Ones: 4 + 9 = 13. Write 3, carry 1. Tens: 5 + 2 + 1 = 8. Answer: 83.", "tags": ["2-digit-carry"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-006", "question": "What is 65 + 15?", "options": ["78", "79", "80", "81"], "correctIndex": 2, "explanation": "65 + 15 = 80. Ones: 5 + 5 = 10. Write 0, carry 1. Tens: 6 + 1 + 1 = 8. Answer: 80.", "tags": ["carry-to-round"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-007", "question": "What is 38 + 43?", "options": ["79", "80", "81", "82"], "correctIndex": 2, "explanation": "38 + 43 = 81. Ones: 8 + 3 = 11. Write 1, carry 1. Tens: 3 + 4 + 1 = 8. Answer: 81.", "tags": ["2-digit-carry"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-008", "question": "A box has 56 red beads and 36 blue beads. How many beads in all?", "options": ["90", "91", "92", "93"], "correctIndex": 2, "explanation": "56 + 36 = 92. Ones: 6 + 6 = 12. Write 2, carry 1. Tens: 5 + 3 + 1 = 9. Answer: 92.", "tags": ["word-problem"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-009", "question": "What is 19 + 19?", "options": ["36", "37", "38", "39"], "correctIndex": 2, "explanation": "19 + 19 = 38. Ones: 9 + 9 = 18. Write 8, carry 1. Tens: 1 + 1 + 1 = 3. Answer: 38.", "tags": ["doubles-carry"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-010", "question": "What is 49 + 1?", "options": ["49", "50", "51", "52"], "correctIndex": 1, "explanation": "49 + 1 = 50. Ones: 9 + 1 = 10. Write 0, carry 1. Tens: 4 + 1 = 5. Answer: 50.", "tags": ["carry-simple"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-011", "question": "What is 74 + 18?", "options": ["90", "91", "92", "93"], "correctIndex": 2, "explanation": "74 + 18 = 92. Ones: 4 + 8 = 12. Write 2, carry 1. Tens: 7 + 1 + 1 = 9. Answer: 92.", "tags": ["2-digit-carry"], "conceptLevel": 2 },
    { "id": "g2m-w21-wed-012", "question": "Rohan saves ₹27 in January and ₹35 in February. How much in total?", "options": ["60", "61", "62", "63"], "correctIndex": 2, "explanation": "27 + 35 = 62. Ones: 7 + 5 = 12. Write 2, carry 1. Tens: 2 + 3 + 1 = 6. Answer: 62.", "tags": ["word-problem-money"], "conceptLevel": 2 },
