  "questions": [
    { "id": "g4m-w23-fri-001", "question": "Meena ate 2/8 of a pizza and Ravi ate 3/8. Together they ate ___.", "options": ["5/8", "5/16", "1/8", "6/8"], "correctIndex": 0, "explanation": "2/8 + 3/8 = 5/8.", "tags": ["word-problem", "addition"] },
    { "id": "g4m-w23-fri-002", "question": "A ribbon is 7/10 m. If 3/10 m is cut off, how much is left?", "options": ["4/10 m", "10/10 m", "4/20 m", "3/10 m"], "correctIndex": 0, "explanation": "7/10 − 3/10 = 4/10 m.", "tags": ["word-problem", "subtraction"] },
    { "id": "g4m-w23-fri-003", "question": "Of 12 students, 1/4 wear glasses. How many is that?", "options": ["2", "3", "4", "6"], "correctIndex": 1, "explanation": "1/4 of 12 = 12 ÷ 4 = 3 students.", "tags": ["word-problem", "fraction-of"] },
    { "id": "g4m-w23-fri-004", "question": "Which fraction is equal to 1/2?", "options": ["3/5", "4/8", "2/5", "3/8"], "correctIndex": 1, "explanation": "4/8 simplifies to 1/2.", "tags": ["equivalent"] },
    { "id": "g4m-w23-fri-005", "question": "A jug holds 5/6 L. After pouring out 2/6 L, how much remains?", "options": ["3/6 L", "7/6 L", "3/12 L", "2/6 L"], "correctIndex": 0, "explanation": "5/6 − 2/6 = 3/6 L.", "tags": ["word-problem", "subtraction"] },
    { "id": "g4m-w23-fri-006", "question": "Which is greater: 3/4 or 2/4?", "options": ["2/4", "3/4", "Equal", "Cannot tell"], "correctIndex": 1, "explanation": "Same denominator — 3 > 2, so 3/4 is greater.", "tags": ["comparison"] },
    { "id": "g4m-w23-fri-007", "question": "1/3 of 9 marbles is ___.", "options": ["2", "3", "4", "6"], "correctIndex": 1, "explanation": "1/3 of 9 = 9 ÷ 3 = 3 marbles.", "tags": ["word-problem", "fraction-of"] },
    { "id": "g4m-w23-fri-008", "question": "Reena coloured 4/9 of a chart and Sam coloured 3/9. Total coloured?", "options": ["7/9", "7/18", "1/9", "12/9"], "correctIndex": 0, "explanation": "4/9 + 3/9 = 7/9.", "tags": ["word-problem", "addition"] },
    { "id": "g4m-w23-fri-009", "question": "6/8 in simplest form is ___.", "options": ["3/4", "2/3", "1/2", "4/6"], "correctIndex": 0, "explanation": "Divide both by 2: 6/8 = 3/4.", "tags": ["simplify"] },
    { "id": "g4m-w23-fri-010", "question": "A cake is cut in 6 parts. 4 are eaten. Fraction left?", "options": ["2/6", "4/6", "6/2", "2/4"], "correctIndex": 0, "explanation": "6 − 4 = 2 parts left, so 2/6.", "tags": ["word-problem"] },
    { "id": "g4m-w23-fri-011", "question": "1/5 + 1/5 + 1/5 = ?", "options": ["3/5", "3/15", "1/5", "1 whole"], "correctIndex": 0, "explanation": "1 + 1 + 1 = 3 over 5, so 3/5.", "tags": ["addition"] },
    { "id": "g4m-w23-fri-012", "question": "Which fraction is the largest?", "options": ["1/2", "1/3", "1/4", "1/6"], "correctIndex": 0, "explanation": "1/2 has the fewest parts, so it is the largest piece.", "tags": ["comparison"] },
    { "id": "g4m-w23-fri-013", "question": "1/4 of 20 sweets is ___.", "options": ["4", "5", "6", "10"], "correctIndex": 1, "explanation": "1/4 of 20 = 20 ÷ 4 = 5 sweets.", "tags": ["word-problem", "fraction-of"] },
    { "id": "g4m-w23-fri-014", "question": "9/10 − 6/10 = ?", "options": ["3/10", "15/10", "3/20", "6/10"], "correctIndex": 0, "explanation": "9 − 6 = 3 over 10, so 3/10.", "tags": ["subtraction"] },
    { "id": "g4m-w23-fri-015", "question": "Two strips: one shows 2/3, the other 4/6. They are ___.", "options": ["Equal", "2/3 bigger", "4/6 bigger", "Cannot tell"], "correctIndex": 0, "explanation": "4/6 simplifies to 2/3, so they are equal.", "tags": ["equivalent"] }
