    { "id": "g3m-w24-tue-001", "question": "Half of 10 is ___.", "options": ["2", "4", "5", "8"], "correctIndex": 2, "explanation": "Half means dividing by 2. 10 ÷ 2 = 5.", "tags": ["fractions", "half"] },
    { "id": "g3m-w24-tue-002", "question": "A quarter of 12 is ___.", "options": ["3", "4", "6", "2"], "correctIndex": 0, "explanation": "A quarter (1/4) means dividing by 4. 12 ÷ 4 = 3.", "tags": ["fractions", "quarter"] },
    { "id": "g3m-w24-tue-003", "question": "Half of 18 is ___.", "options": ["4", "6", "8", "9"], "correctIndex": 3, "explanation": "18 ÷ 2 = 9.", "tags": ["fractions", "half"] },
    { "id": "g3m-w24-tue-004", "question": "A quarter of 20 is ___.", "options": ["4", "5", "10", "8"], "correctIndex": 1, "explanation": "20 ÷ 4 = 5.", "tags": ["fractions", "quarter"] },
    { "id": "g3m-w24-tue-005", "question": "Kavya has 16 stickers. She gives half to her friend. How many does she give away?", "options": ["4", "6", "8", "12"], "correctIndex": 2, "explanation": "Half of 16 = 16 ÷ 2 = 8 stickers.", "tags": ["fractions", "half", "word-problem"] },
    { "id": "g3m-w24-tue-006", "question": "A quarter of 40 is ___.", "options": ["4", "8", "10", "20"], "correctIndex": 2, "explanation": "40 ÷ 4 = 10.", "tags": ["fractions", "quarter"] },
    { "id": "g3m-w24-tue-007", "question": "2 quarters = ___.", "options": ["1/4", "1/2", "3/4", "1 whole"], "correctIndex": 1, "explanation": "2 quarters = 2/4 = 1/2 (half). Two quarter-pieces make one half.", "tags": ["fractions", "equivalent"] },
    { "id": "g3m-w24-tue-008", "question": "Half of 30 is ___.", "options": ["10", "12", "15", "20"], "correctIndex": 2, "explanation": "30 ÷ 2 = 15.", "tags": ["fractions", "half"] },
